{
  "name": "taskboard",
  "displayName": "Plány a úkoly",
  "description": "Zobrazí tasks/prehled-planu.md jako tabulku v postranní liště s ikonami podle stavu a odznakem počtu otevřených úkolů.",
  "version": "0.1.0",
  "publisher": "ferbar",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:tasks/prehled-planu.md"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskBoard",
          "title": "Plány a úkoly",
          "icon": "resources/checklist.svg"
        }
      ]
    },
    "views": {
      "taskBoard": [
        {
          "type": "webview",
          "id": "taskBoard.tabulka",
          "name": "Plány a úkoly"
        }
      ]
    },
    "commands": [
      {
        "command": "taskBoard.obnovit",
        "title": "Obnovit",
        "category": "Plány a úkoly",
        "icon": "$(refresh)"
      },
      {
        "command": "taskBoard.otevritSoubor",
        "title": "Otevřít přehled plánů",
        "category": "Plány a úkoly",
        "icon": "$(open-preview)"
      },
      {
        "command": "taskBoard.upravitDal",
        "title": "✏️ Upravit „Dál“…",
        "category": "Plány a úkoly"
      },
      {
        "command": "taskBoard.kopirovat",
        "title": "✨ Vložit do Clauda (celá sekce)",
        "category": "Plány a úkoly"
      },
      { "command": "taskBoard.stav.napad", "title": "💡 nápad", "category": "Plány a úkoly", "enablement": "stavId != 'napad'" },
      { "command": "taskBoard.stav.napadLadi", "title": "💡 nápad, ladí se", "category": "Plány a úkoly", "enablement": "stavId != 'napadLadi'" },
      { "command": "taskBoard.stav.zadani", "title": "○ zadání", "category": "Plány a úkoly", "enablement": "stavId != 'zadani'" },
      { "command": "taskBoard.stav.rozpracovano", "title": "▶ rozpracováno", "category": "Plány a úkoly", "enablement": "stavId != 'rozpracovano'" },
      { "command": "taskBoard.stav.odlozeno", "title": "⏸ odloženo", "category": "Plány a úkoly", "enablement": "stavId != 'odlozeno'" },
      { "command": "taskBoard.stav.hotovo", "title": "✔ hotovo", "category": "Plány a úkoly", "enablement": "stavId != 'hotovo'" },
      {
        "command": "taskBoard.smazat",
        "title": "🗑️ Smazat úkol…",
        "category": "Plány a úkoly"
      },
      {
        "command": "taskBoard.smazatHotove",
        "title": "Smazat všechny hotové…",
        "category": "Plány a úkoly",
        "icon": "$(clear-all)",
        "enablement": "taskBoard.maHotove"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskBoard.obnovit",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@1"
        },
        {
          "command": "taskBoard.otevritSoubor",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@2"
        },
        {
          "command": "taskBoard.smazatHotove",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        { "command": "taskBoard.stav.napad", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@1" },
        { "command": "taskBoard.stav.napadLadi", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@2" },
        { "command": "taskBoard.stav.zadani", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@3" },
        { "command": "taskBoard.stav.rozpracovano", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@4" },
        { "command": "taskBoard.stav.odlozeno", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@5" },
        { "command": "taskBoard.stav.hotovo", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@6" },
        {
          "command": "taskBoard.upravitDal",
          "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'",
          "group": "2_uprava@1"
        },
        {
          "command": "taskBoard.kopirovat",
          "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'",
          "group": "3_kopie@1"
        },
        {
          "command": "taskBoard.smazat",
          "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'",
          "group": "4_smazani@1"
        }
      ],
      "commandPalette": [
        { "command": "taskBoard.upravitDal", "when": "false" },
        { "command": "taskBoard.kopirovat", "when": "false" },
        { "command": "taskBoard.smazat", "when": "false" },
        { "command": "taskBoard.stav.napad", "when": "false" },
        { "command": "taskBoard.stav.napadLadi", "when": "false" },
        { "command": "taskBoard.stav.zadani", "when": "false" },
        { "command": "taskBoard.stav.rozpracovano", "when": "false" },
        { "command": "taskBoard.stav.odlozeno", "when": "false" },
        { "command": "taskBoard.stav.hotovo", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Plány a úkoly",
      "properties": {
        "taskBoard.soubor": {
          "type": "string",
          "default": "tasks/prehled-planu.md",
          "description": "Cesta k souboru s přehledem plánů (relativně ke kořeni workspace, nebo absolutní)."
        },
        "taskBoard.badgeStavy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "nápad",
            "nápad, ladí se",
            "zadání",
            "rozpracováno"
          ],
          "description": "Stavy (sloupec Stav), které se započítají do čísla na ikoně v activity baru."
        }
      }
    }
  }
}
