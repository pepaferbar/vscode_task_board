{
  "name": "taskboard",
  "displayName": "Úkolník",
  "description": "Zobrazí databázi úkolů v Notionu jako tabulku v postranní liště s ikonami podle stavu a odznakem počtu otevřených úkolů.",
  "version": "0.1.0",
  "publisher": "ferbar",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskBoard",
          "title": "Úkolník",
          "icon": "resources/checklist.svg"
        }
      ]
    },
    "views": {
      "taskBoard": [
        {
          "type": "webview",
          "id": "taskBoard.tabulka",
          "name": "Úkolník"
        }
      ]
    },
    "commands": [
      {
        "command": "taskBoard.obnovit",
        "title": "Obnovit",
        "category": "Úkolník",
        "icon": "$(refresh)"
      },
      {
        "command": "taskBoard.otevritSoubor",
        "title": "Otevřít databázi v Notionu",
        "category": "Úkolník",
        "icon": "$(link-external)"
      },
      {
        "command": "taskBoard.nastavitToken",
        "title": "Nastavit token Notionu…",
        "category": "Úkolník"
      },
      {
        "command": "taskBoard.importovatMd",
        "title": "Importovat úkoly z prehled-planu.md do Notionu…",
        "category": "Úkolník"
      },
      {
        "command": "taskBoard.pridat",
        "title": "➕ Nový úkol…",
        "category": "Úkolník",
        "icon": "$(add)"
      },
      {
        "command": "taskBoard.kopirovat",
        "title": "📋 Kopírovat pro Clauda (celý úkol)",
        "category": "Úkolník"
      },
      { "command": "taskBoard.stav.napad", "title": "💡 nápad", "category": "Úkolník", "enablement": "stavId != 'napad'" },
      { "command": "taskBoard.stav.napadLadi", "title": "💡 nápad, ladí se", "category": "Úkolník", "enablement": "stavId != 'napadLadi'" },
      { "command": "taskBoard.stav.zadani", "title": "○ zadání", "category": "Úkolník", "enablement": "stavId != 'zadani'" },
      { "command": "taskBoard.stav.rozpracovano", "title": "▶ rozpracováno", "category": "Úkolník", "enablement": "stavId != 'rozpracovano'" },
      { "command": "taskBoard.stav.odlozeno", "title": "⏸ odloženo", "category": "Úkolník", "enablement": "stavId != 'odlozeno'" },
      { "command": "taskBoard.stav.hotovo", "title": "✔ hotovo", "category": "Úkolník", "enablement": "stavId != 'hotovo'" },
      {
        "command": "taskBoard.smazat",
        "title": "🗑️ Smazat úkol…",
        "category": "Úkolník"
      },
      {
        "command": "taskBoard.zobrazitHotove",
        "title": "Zobrazit hotové",
        "category": "Úkolník",
        "icon": "$(eye-closed)"
      },
      {
        "command": "taskBoard.skrytHotove",
        "title": "Skrýt hotové",
        "category": "Úkolník",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskBoard.pridat",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@0"
        },
        {
          "command": "taskBoard.obnovit",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@1"
        },
        {
          "command": "taskBoard.otevritSoubor",
          "when": "view == taskBoard.tabulka",
          "group": "navigation@2"
        },
        {
          "command": "taskBoard.zobrazitHotove",
          "when": "view == taskBoard.tabulka && !taskBoard.zobrazitHotove",
          "group": "navigation@3"
        },
        {
          "command": "taskBoard.skrytHotove",
          "when": "view == taskBoard.tabulka && taskBoard.zobrazitHotove",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        { "command": "taskBoard.pridat", "when": "webviewId == 'taskBoard.tabulka'", "group": "0_novy@1" },
        { "command": "taskBoard.stav.napad", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@1" },
        { "command": "taskBoard.stav.napadLadi", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@2" },
        { "command": "taskBoard.stav.zadani", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@3" },
        { "command": "taskBoard.stav.rozpracovano", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@4" },
        { "command": "taskBoard.stav.odlozeno", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@5" },
        { "command": "taskBoard.stav.hotovo", "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'", "group": "1_stav@6" },
        {
          "command": "taskBoard.kopirovat",
          "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'",
          "group": "3_kopie@1"
        },
        {
          "command": "taskBoard.smazat",
          "when": "webviewId == 'taskBoard.tabulka' && webviewSection == 'ukol'",
          "group": "4_smazani@1"
        }
      ],
      "commandPalette": [
        { "command": "taskBoard.kopirovat", "when": "false" },
        { "command": "taskBoard.smazat", "when": "false" },
        { "command": "taskBoard.stav.napad", "when": "false" },
        { "command": "taskBoard.stav.napadLadi", "when": "false" },
        { "command": "taskBoard.stav.zadani", "when": "false" },
        { "command": "taskBoard.stav.rozpracovano", "when": "false" },
        { "command": "taskBoard.stav.odlozeno", "when": "false" },
        { "command": "taskBoard.stav.hotovo", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Úkolník",
      "properties": {
        "taskBoard.databaze": {
          "type": "string",
          "default": "",
          "description": "ID databáze úkolů v Notionu, nebo celý odkaz na ni (ID se z odkazu vytáhne samo). Token integrace se ukládá zvlášť příkazem „Nastavit token Notionu“."
        },
        "taskBoard.intervalMinut": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Jak často (v minutách) se úkoly samy načtou z Notionu. 0 = jen ručně a při zobrazení panelu."
        },
        "taskBoard.badgeStavy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "nápad",
            "nápad, ladí se",
            "zadání",
            "rozpracováno"
          ],
          "description": "Stavy (sloupec Stav), které se započítají do čísla na ikoně v activity baru."
        }
      }
    }
  }
}
